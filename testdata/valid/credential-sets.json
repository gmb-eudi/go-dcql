{
  "credentials": [
    {
      "id": "pid_sdjwt",
      "format": "dc+sd-jwt",
      "meta": { "vct_values": ["urn:eudi:pid:1"] },
      "claims": [
        { "path": ["given_name"] },
        { "path": ["family_name"] }
      ]
    },
    {
      "id": "pid_mdoc",
      "format": "mso_mdoc",
      "meta": { "doctype_value": "eu.europa.ec.eudi.pid.1" },
      "claims": [
        { "path": ["eu.europa.ec.eudi.pid.1", "given_name"] },
        { "path": ["eu.europa.ec.eudi.pid.1", "family_name"] }
      ]
    },
    {
      "id": "reward_card",
      "format": "dc+sd-jwt",
      "meta": { "vct_values": ["https://loyalty.example.com/card"] }
    }
  ],
  "credential_sets": [
    { "options": [["pid_sdjwt"], ["pid_mdoc"]] },
    { "options": [["reward_card"]], "required": false }
  ]
}
